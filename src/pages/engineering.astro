---
import PostRows from '../components/PostRows.astro';
import SmartLink from '../components/SmartLink.astro';
import Site from '../layouts/Site.astro';
import { getPosts, getSiteSettings, getWorkPage } from '../lib/sanity';

const [settings, work, allPosts] = await Promise.all([getSiteSettings(), getWorkPage(), getPosts()]);
if (!work) throw new Error('Sanity: the "Work page" document is missing.');

const headline = work.headline ?? [];
const posts = work.writingPosts?.length ? work.writingPosts : allPosts.slice(0, 2);
---

<Site {settings} title={work.seoTitle ?? 'Work'} description={work.seoDescription}>
	<section class="container" style="padding-block: clamp(56px, 8vw, 104px) 72px">
		{work.kicker && <p class="kicker">{work.kicker}</p>}
		<h1 class="display" style="max-width: 1000px; font-size: clamp(48px, 7vw, 104px)">
			{
				headline.map((line, index) => (
					<>
						{index > 0 && <br />}
						{line}
					</>
				))
			}<span class="caret" aria-hidden="true">_</span>
		</h1>
		{work.intro && <p class="lead" style="max-width: 620px">{work.intro}</p>}
	</section>

	{
		work.projects?.length ? (
			<section class="container" style="padding-bottom: 72px">
				<div class="project-grid">
					{work.projects.map((project) => {
						const Card = project.url ? SmartLink : 'div';
						const dark = project.cardStyle === 'dark';
						return (
							<Card class:list={['project-card', { 'is-dark': dark }]} href={project.url}>
								{project.status === 'in-progress' ? (
									<span class="status">● in progress</span>
								) : (
									project.meta && <span class="meta">{project.meta}</span>
								)}
								<h2>{project.name}</h2>
								<p>{project.description ?? project.summary}</p>
								{project.stack?.length && !dark ? (
									<div class="chips">
										{project.stack.map((item) => (
											<span>{item}</span>
										))}
									</div>
								) : null}
								{project.url && dark && <span class="go">{project.url.replace(/^https?:\/\//, '')} ↗</span>}
								{project.watermark && (
									<span class="watermark" data-parallax="0.12" data-parallax-max="60" aria-hidden="true">
										{project.watermark}
									</span>
								)}
							</Card>
						);
					})}
				</div>
			</section>
		) : null
	}

	{
		work.services?.length ? (
			<section class="container section">
				{work.servicesKicker && <p class="kicker">{work.servicesKicker}</p>}
				{work.servicesHeading && <h2 class="h2">{work.servicesHeading}</h2>}
				<div class="card-grid">
					{work.services.map((item, index) => (
						<div class="svc" data-cursor-invert data-parallax={(0.02 + index * 0.02).toFixed(2)} data-parallax-max="40">
							<span class="mono">{String(index + 1).padStart(2, '0')}</span>
							<h3>{item.title}</h3>
							{item.description && <p>{item.description}</p>}
						</div>
					))}
				</div>
			</section>
		) : null
	}

	{
		work.stack?.length ? (
			<section class="container section">
				<div class="stack-wrap">
					<div>
						{work.stackKicker && <p class="kicker">{work.stackKicker}</p>}
						{work.stackHeading && <h2 class="h2">{work.stackHeading}</h2>}
						{work.stackNote && <p class="note">{work.stackNote}</p>}
					</div>
					<div class="tags">
						{work.stack.map((tool) => (
							<span class:list={{ 'is-highlight': tool.highlight }}>{tool.name}</span>
						))}
					</div>
				</div>
			</section>
		) : null
	}

	{
		posts.length ? (
			<section class="container section" style="padding-bottom: 120px">
				<div class="section-head">
					<div>
						{work.writingKicker && <p class="kicker">{work.writingKicker}</p>}
						{work.writingHeading && <h2 class="h2">{work.writingHeading}</h2>}
					</div>
					<a href="/blog/">All writing →</a>
				</div>
				<PostRows {posts} dateStyle="short" showDescription={false} />
			</section>
		) : null
	}
</Site>
