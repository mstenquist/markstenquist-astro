---
import PostRows from '../../components/PostRows.astro';
import Site from '../../layouts/Site.astro';
import { formatDate, getBlogPage, getPosts, getSiteSettings, readingTime } from '../../lib/sanity';

const [settings, page, posts] = await Promise.all([getSiteSettings(), getBlogPage(), getPosts()]);
const [latest] = posts;
---

<Site {settings} title={page?.seoTitle ?? 'Writing'} description={page?.seoDescription ?? page?.intro}>
	<section class="container blog-hero">
		<div>
			{page?.kicker && <p class="kicker">{page.kicker}</p>}
			<h1 class="display">{page?.heading ?? 'Writing'}<span class="caret" aria-hidden="true">_</span></h1>
		</div>
		<aside>
			{page?.intro && <p>{page.intro}</p>}
			<a class="rss" href="/rss.xml">RSS feed</a>
		</aside>
	</section>

	{
		latest && (
			<section class="container" style="padding-bottom: 72px">
				<a class="feature" href={`/blog/${latest.slug}/`} data-cursor-label="read post →">
					<span class="feature-text">
						<span class="mono">
							latest · {formatDate(latest.publishedAt)} · {readingTime(latest.wordCount)}
						</span>
						<strong>{latest.title}</strong>
						<span>{latest.description}</span>
					</span>
					<span class="round-go" aria-hidden="true">
						→
					</span>
				</a>
			</section>
		)
	}

	{
		posts.length ? (
			<section class="container" style="padding-block: 24px 120px">
				{page?.listKicker && <p class="kicker" style="margin-bottom: 20px">{page.listKicker}</p>}
				<PostRows {posts} />
			</section>
		) : (
			<section class="container" style="padding-bottom: 120px">
				<p class="lead">No posts yet.</p>
			</section>
		)
	}
</Site>
