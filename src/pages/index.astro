---
import SmartLink from '../components/SmartLink.astro';
import Site from '../layouts/Site.astro';
import { getHomePage, getSiteSettings, urlFor } from '../lib/sanity';

const [settings, home] = await Promise.all([getSiteSettings(), getHomePage()]);
if (!home) throw new Error('Sanity: the "Home page" document is missing.');

const headline = home.headline ?? [];
const lastLine = headline.at(-1);
const photo = settings.photo?.asset ? urlFor(settings.photo).width(920).height(920).url() : '/images/mark-feature-photo.jpg';
---

<Site {settings}>
	<section class="container hero">
		<div class="hero-text">
			{home.eyebrow && <p class="pill"><span class="pulse-dot" aria-hidden="true" />{home.eyebrow}</p>}
			<h1 class="display">
				{
					headline.slice(0, -1).map((line) => (
						<>
							{line}
							<br />
						</>
					))
				}
				<span class="accent">{lastLine}</span><span class="caret" aria-hidden="true">_</span>
			</h1>
			{home.intro && <p class="lead">{home.intro}</p>}
			<div class="btn-row">
				{
					home.primaryCta && (
						<SmartLink class="btn btn-primary" href={home.primaryCta.href} data-magnetic>
							{home.primaryCta.label} <span aria-hidden="true">→</span>
						</SmartLink>
					)
				}
				{
					home.secondaryCta && (
						<SmartLink class="btn btn-secondary" href={home.secondaryCta.href}>
							{home.secondaryCta.label}
						</SmartLink>
					)
				}
			</div>
		</div>
		<div class="hero-media">
			<div class="photo-card" data-tilt>
				<img src={photo} alt={settings.photo?.alt ?? settings.name} width="460" height="460" loading="eager" fetchpriority="high" />
				<div class="photo-card-meta">
					<span>{settings.handle}</span><span>{settings.location}</span>
				</div>
			</div>
			{
				home.terminalCommand && (
					<div class="float float-terminal" data-mouse="36" data-parallax="0.08" data-parallax-max="60" aria-hidden="true">
						<span class="prompt">$</span> {home.terminalCommand}
						{home.terminalResult && (
							<>
								<br />
								<span class="ok">✓</span> {home.terminalResult}
							</>
						)}
					</div>
				)
			}
			{
				home.badge && (
					<div class="float float-badge" data-mouse="-28" data-parallax="-0.05" data-parallax-max="40">
						<span aria-hidden="true">●</span> {home.badge}
					</div>
				)
			}
		</div>
	</section>

	{
		home.nowProjects?.length ? (
			<section class="container" aria-label={home.nowLabel ?? 'Building now'}>
				<div class="terminal" data-parallax="0.04" data-parallax-max="40">
					<div class="terminal-bar" aria-hidden="true">
						<i />
						<i />
						<i />
						<span>{home.nowLabel}</span>
					</div>
					<div class="terminal-list">
						{home.nowProjects.map((project) => {
							const Row = project.url ? SmartLink : 'div';
							return (
								<Row class="terminal-row" href={project.url}>
									<strong>{project.name}</strong>
									<p>{project.summary}</p>
									<span class="mono">
										{project.tag}
										{project.url && /^https?:/.test(project.url) ? ' ↗' : ''}
									</span>
								</Row>
							);
						})}
					</div>
				</div>
			</section>
		) : null
	}

	{
		home.interests?.length ? (
			<section class="container section">
				{home.interestsKicker && <p class="kicker">{home.interestsKicker}</p>}
				{home.interestsHeading && <h2 class="h2">{home.interestsHeading}</h2>}
				<div class="card-grid">
					{home.interests.map((item, index) => (
						<div class="svc">
							<span class="mono">{String(index + 1).padStart(2, '0')}</span>
							<h3>{item.title}</h3>
							{item.description && <p>{item.description}</p>}
						</div>
					))}
				</div>
			</section>
		) : null
	}

	{
		home.career?.length ? (
			<section class="container section" id="about">
				{home.careerKicker && <p class="kicker">{home.careerKicker}</p>}
				{home.careerHeading && <h2 class="h2">{home.careerHeading}</h2>}
				<div class="timeline" data-timeline>
					<div class="timeline-track" aria-hidden="true" />
					<div class="timeline-fill" aria-hidden="true" />
					<ol class="timeline-items" role="list" style="list-style: none; margin: 0; padding: 0">
						{home.career.map((entry) => (
							<li class:list={['timeline-item', { 'is-current': entry.current }]}>
								<span class="timeline-dot" aria-hidden="true" />
								<span class="mono">{entry.year}</span>
								<strong>{entry.title}</strong>
								{entry.description && <p>{entry.description}</p>}
							</li>
						))}
					</ol>
				</div>
			</section>
		) : null
	}
</Site>
