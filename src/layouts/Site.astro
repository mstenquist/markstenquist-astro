---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import type { SiteSettings } from '../lib/sanity';

interface Props {
	settings: SiteSettings;
	title?: string;
	description?: string;
	image?: string;
	type?: 'website' | 'article';
	progress?: boolean;
	grid?: boolean;
}

const { settings, title, description, image, type, progress, grid = true } = Astro.props;
const pageTitle = title ? `${title} | ${settings.name}` : (settings.seoTitle ?? settings.name);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={pageTitle} description={description ?? settings.seoDescription ?? ''} {settings} {image} {type} />
	</head>
	<body>
		<a class="skip-link" href="#main">Skip to content</a>
		<Header {settings} {progress} />
		<main id="main" class:list={{ 'grid-bg': grid }}>
			<slot />
		</main>
		<Footer {settings} />
		<script>
			import '../scripts/motion';
		</script>
	</body>
</html>
