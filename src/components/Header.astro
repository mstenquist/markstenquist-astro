---
import type { SiteSettings } from '../lib/sanity';
import SmartLink from './SmartLink.astro';

interface Props {
	settings: SiteSettings;
	progress?: boolean;
}

const { settings, progress = false } = Astro.props;
const path = Astro.url.pathname;
const isCurrent = (href: string) => href.startsWith('/') && href !== '/' && path.startsWith(href.replace(/\/$/, ''));
---

<header class="site-header">
	<div class="container">
		<a class="logo" href="/">
			{settings.logoMark && <span class="logo-mark" aria-hidden="true">{settings.logoMark}</span>}
			{settings.name}
		</a>
		<nav class="nav" aria-label="Main">
			{
				settings.nav?.map((link) => (
					<SmartLink href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>
						{link.label}
					</SmartLink>
				))
			}
			{
				settings.navCta && (
					<SmartLink class="nav-cta" href={settings.navCta.href}>
						{settings.navCta.label}
					</SmartLink>
				)
			}
		</nav>
	</div>
	{progress && <div class="progress" data-progress aria-hidden="true" />}
</header>
