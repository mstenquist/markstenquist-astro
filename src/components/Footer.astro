---
import type { SiteSettings } from '../lib/sanity';
import SmartLink from './SmartLink.astro';

interface Props {
	settings: SiteSettings;
}

const { settings } = Astro.props;
const [first, ...rest] = settings.footerButtons ?? [];
---

<footer class="site-footer" id="contact">
	<div class="container">
		{settings.footerHeading && <h2>{settings.footerHeading}</h2>}
		<div class="btn-row">
			{first && <SmartLink class="btn btn-light" href={first.href}>{first.label}</SmartLink>}
			{
				rest.map((link) => (
					<SmartLink class="btn btn-outline-light" href={link.href}>
						{link.label}
					</SmartLink>
				))
			}
		</div>
		<div class="footer-bottom">
			<nav aria-label="Elsewhere">
				{
					settings.socials?.map((link) => (
						<SmartLink href={link.href}>{link.label}</SmartLink>
					))
				}
			</nav>
			<span>© {new Date().getFullYear()} {settings.name}</span>
		</div>
	</div>
</footer>
